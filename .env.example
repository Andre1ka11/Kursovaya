# Optional local overrides. Existing process environment variables take precedence.
# Uncomment a line to override configs/agent.yaml.
# AGENT_LOG_LEVEL=debug
# AGENT_LOG_FORMAT=json
# AGENT_TIMEZONE=Europe/Moscow
# AGENT_SHUTDOWN_TIMEOUT=10s
# AGENT_HEARTBEAT_INTERVAL=30s

# Telegram: create a bot with @BotFather and fill these values in your local .env.
# AGENT_TELEGRAM_ENABLED=true
# AGENT_BOT_TOKEN=123456789:replace_with_your_bot_token
# AGENT_ALLOWED_USER_IDS=123456789
# Multiple allowed user IDs are separated by commas.
